{
	"name": "fido2-js",
	"version": "2.0.0",
	"license": "MIT",
	"author": "SirKostya009",
	"description": "Low-level library for parsing and verifying FIDO2 attestations and assertions",
	"type": "module",
	"scripts": {
		"test": "node --test --experimental-strip-types --experimental-transform-types --experimental-test-coverage ./test/node.ts",
		"test:watch": "node --test --experimental-strip-types --experimental-transform-types --experimental-test-coverage --watch ./test/node.ts"
	},
	"files": [
		"esm",
		"cjs"
	],
	"exports": {
		".": {
			"import": "./esm/",
			"require": "./cjs/"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sirkostya009/fido2-js.git"
	},
	"keywords": [
		"webauthn",
		"passkey",
		"security key",
		"yubikey",
		"u2f",
		"fido",
		"fido2",
		"lib",
		"authentication",
		"web authentication",
		"server"
	],
	"bugs": {
		"url": "https://github.com/sirkostya009/fido2-js/issues"
	},
	"homepage": "https://github.com/sirkostya009/fido2-js#readme",
	"dependencies": {
		"cbor-x": "^1.6.0"
	},
	"devDependencies": {
		"@types/node": "^22.9.0"
	},
	"sideEffects": false
}
