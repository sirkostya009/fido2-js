{
	"name": "fido2-js",
	"version": "2.0.0",
	"license": "MIT",
	"author": "SirKostya009",
	"description": "Library for parsing and verifying FIDO2 WebAuthn attestations and assertions",
	"scripts": {
		"test": "node --test --experimental-strip-types --experimental-transform-types --experimental-test-coverage ./test/node.ts",
		"test:watch": "node --test --experimental-strip-types --experimental-transform-types --experimental-test-coverage --watch ./test/node.ts"
	},
	"files": [
		"types.d.ts",
		"esm",
		"cjs"
	],
	"exports": {
		".": {
			"import": "./esm/index.js",
			"require": "./cjs/index.js"
		},
		"./parse": {
			"import": "./esm/parse.js",
			"require": "./cjs/parse.js"
		},
		"./utils": {
			"import": "./esm/utils.js",
			"require": "./cjs/utils.js"
		}
	},
	"repository": "github:sirkostya009/fido2-js",
	"keywords": [
		"webauthn",
		"passkey",
		"security key",
		"yubikey",
		"u2f",
		"fido",
		"fido2",
		"lib",
		"authentication",
		"web authentication"
	],
	"bugs": {
		"url": "https://github.com/sirkostya009/fido2-js/issues"
	},
	"homepage": "https://github.com/sirkostya009/fido2-js#readme",
	"dependencies": {
		"cbor-x": "^1.6.0"
	},
	"devDependencies": {
		"@types/node": "^22.9.0"
	},
	"sideEffects": false
}
